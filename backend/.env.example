# Local backend settings. Never commit real credentials.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Optional: for persistent data, configure Supabase on the backend only.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# APP_URL=https://your-custom-domain.example
